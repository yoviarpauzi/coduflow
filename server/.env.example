DB_NAME=coduflow
DB_USER=coduflow
DB_PASSWORD=coduflow
DB_URI=mongodb://${DB_USER}:${DB_PASSWORD}@localhost:27017/${DB_NAME}?authSource=admin&replicaSet=rs0

LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE=30
LOG_COMPRESS=true

REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=coduflow
REDIS_DB=0

PASETO_ACCESS_SECRET_KEY=random-32-char
PASETO_REFRESH_SECRET_KEY=random-32-char
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h
